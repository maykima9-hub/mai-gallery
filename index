<div class="shade" id="shade"></div>
<aside id="cart" aria-label="עגלת קניות" aria-hidden="true">
 <div class="ch"><h2>העגלה שלי</h2><button class="x" id="closeCart" aria-label="סגירה">×</button></div>
 <div id="items"></div>
 <div class="receipt" id="rcpt" hidden>
  <div class="rh"><h3>קבלת הזמנה</h3><small>מס׳ <span id="rno"></span><br><span id="rdate"></span></small></div>
  <div class="rr"><span>פריטים</span><span id="rn">0</span></div>
  <div class="rr"><span>סכום ביניים</span><span id="sub">0 ₪</span></div>
  <div class="rr"><span>איסוף</span><span>איסוף עצמי בתיאום מראש</span></div>
  <div class="rr t"><span>סה"כ לתשלום</span><span id="total">0 ₪</span></div>
  <p class="rthx">תודה שבחרתם בציורים מקוריים</p>
 </div>
 
 <a class="wa" id="wa" href="#" target="_blank" rel="noopener">שליחת ההזמנה בוואטסאפ</a>
</aside>
<div id="lb" role="dialog" aria-modal="true" aria-label="תצוגה מוגדלת"><button class="x" id="closeLb" aria-label="סגירה">×</button><div id="lbArt"></div><p id="lbTxt"></p></div>

<script>
/* ===== כאן עורכים: מספר וואטסאפ וציורים ===== */
const PHONE = "972549816989"; // בפורמט בינלאומי, בלי + ובלי 0 בהתחלה
const PAINTINGS = [
 // price:null = "מחיר בפנייה". year אופציונלי. sold:true = נמכר.
{id:1,title:"בית על הגבעה",cat:"נוף",tech:"צבעי פנדה על קנבס",size:"15×15 ס״מ",year:2027,price:15,img:"data:image/jpeg;base64,"},
 {id:2,title:"ריקוד הצבעים",cat:"מופשט",tech:"אקריליק על קנבס",size:"40×40 ס״מ",year:2027,price:45,img:"data:image/jpeg;base64,"},
 {id:3,title:"חלון לים",cat:"נוף",tech:"ציור על קנבס",year:2027,price:60,img:"data:image/jpeg;base64,"},
 {id:4,title:"קסם בכחול וזהב",cat:"מופשט",tech:"צבעי מים על נייר",size:"A4",year:2027,price:45,img:"data:image/jpeg;base64,"},
 {id:5,title:"חתולים בחלון",cat:"חיות",tech:"צבעי מים על נייר",size:"A4",year:2027,price:60,img:"data:image/jpeg;base64,"},
 {id:6,title:"כפר בשלג",cat:"נוף",tech:"עפרונות צבעוניים על נייר",size:"A4",year:2027,price:60,img:"data:image/jpeg;base64,"},
 {id:7,title:"שועל אפריקאי",cat:"חיות",tech:"גואש על בד",size:"30×30 ס״מ",year:2027,price:55,img:"data:image/jpeg;base64,"}
];
/* ===== מכאן והלאה אין צורך לגעת ===== */
const $=s=>document.querySelector(s),nis=n=>n.toLocaleString("he-IL")+" ₪";
const pal=[["#1e1b3a","#3346e0","#e6338a","#ffc531"],["#0f766e","#14b8a6","#ffc531","#ff6b57"],["#ff6b57","#e6338a","#7c3aed","#ffd98a"],["#264653","#2a9d8f","#e9c46a","#f4a261"],["#3346e0","#8fb8ff","#ffffff","#ffc531"],["#7c3aed","#e6338a","#ffc531","#14b8a6"]];
const catColors=["#3346e0","#e6338a","#14b8a6","#7c3aed","#ff6b57"];
const orderNo="M"+Date.now().toString().slice(-6);
let uid=0,cart=[],filter="הכל";
try{cart=JSON.parse(localStorage.getItem("cart")||"[]").filter(id=>PAINTINGS.some(p=>p.id===id&&!p.sold&&p.price!=null))}catch(e){}
const meta=p=>[p.tech,p.size,p.year].filter(Boolean).join(" · ");
const save=()=>{try{localStorage.setItem("cart",JSON.stringify(cart))}catch(e){}};
function rng(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function gen(id){
 const r=rng(id*97+13),p=pal[id%pal.length],g="g"+(++uid);
 let s=`<svg class="art" viewBox="0 0 100 125" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img"><defs><linearGradient id="${g}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${p[0]}"/><stop offset="1" stop-color="${p[1]}"/></linearGradient></defs><rect width="100" height="125" fill="url(#${g})"/>`;
 for(let i=0;i<4;i++)s+=`<circle cx="${r()*100}" cy="${r()*70}" r="${12+r()*26}" fill="${p[2+i%2]}" opacity="${.35+r()*.4}"/>`;
 s+=`<circle cx="${30+r()*40}" cy="${28+r()*22}" r="15" fill="${p[3]}"/>`;
 for(let i=0;i<3;i++){const y=66+i*20+r()*6,h=10+r()*10;s+=`<path d="M0 ${y} Q25 ${y-h} 50 ${y} T100 ${y} V125 H0Z" fill="${p[(i+1)%4]}" opacity=".88"/>`}
 return s+"</svg>";
}
function art(p){
 const d=document.createElement("div");d.innerHTML=gen(p.id);
 if(p.img){const im=new Image();im.className="art";im.alt=p.title+", "+p.tech;im.onload=()=>{im.style.aspectRatio=im.naturalWidth+"/"+im.naturalHeight;d.replaceChildren(im)};im.src=p.img}
 return d;
}
function framed(p,i){
 const f=document.createElement("div");f.className="frame f"+(i%5);
 const m=document.createElement("div");m.className="mat";m.append(art(p));f.append(m);return f;
}
function render(){
 const cats=["הכל",...new Set(PAINTINGS.map(p=>p.cat))];
 $("#filters").innerHTML="";
 cats.forEach(c=>{const b=document.createElement("button");b.textContent=c;b.setAttribute("aria-pressed",c===filter);b.onclick=()=>{filter=c;render()};$("#filters").append(b)});
 const g=$("#grid");g.innerHTML="";
 PAINTINGS.filter(p=>filter==="הכל"||p.cat===filter).forEach(p=>{
  const el=document.createElement("article");el.className="piece";
  const fr=framed(p,p.id);fr.tabIndex=0;fr.setAttribute("role","button");fr.setAttribute("aria-label","הגדלת "+p.title);
  fr.onclick=()=>zoom(p);fr.onkeydown=e=>{if(e.key==="Enter")zoom(p)};
  const ci=[...new Set(PAINTINGS.map(x=>x.cat))].indexOf(p.cat);
  const lab=document.createElement("div");lab.className="label";lab.style.setProperty("--cc",catColors[ci%catColors.length]);
  lab.innerHTML=`<span class="chip">${p.cat}</span><h3>${p.title}</h3><div class="meta">${meta(p)}</div><div class="row">${`<span class="price">${nis(p.price)}</span>${p.sold?'<span class="sold">נמכר</span>':cart.includes(p.id)?'<span class="incart">✓ בעגלה</span>':'<button class="add">הוספה לעגלה</button>'}`}</div>`;
  const add=lab.querySelector("button.add");if(add)add.onclick=()=>{cart.push(p.id);save();render();openCart()};
  el.append(fr,lab);g.append(el);
 });
 paint();
}
function paint(){
 $("#count").textContent=cart.length;
 const box=$("#items");box.innerHTML="";
 if(!cart.length)box.innerHTML='<p class="empty">העגלה ריקה. בחרו ציור מהגלריה כדי להתחיל.</p>';
 let sum=0,lines=[];
 cart.forEach(id=>{const p=PAINTINGS.find(x=>x.id===id);sum+=p.price;lines.push(`• ${p.title} (${nis(p.price)})`);
  const r=document.createElement("div");r.className="item";
  r.innerHTML=`<div>${p.title}<small>${meta(p)}</small></div><div>${nis(p.price)}<br><button>הסרה</button></div>`;
  r.querySelector("button").onclick=()=>{cart=cart.filter(x=>x!==id);save();render()};box.append(r)});
 $("#rcpt").hidden=!cart.length;$("#print").hidden=!cart.length;
 $("#rno").textContent=orderNo;$("#rdate").textContent=new Date().toLocaleDateString("he-IL");
 $("#rn").textContent=cart.length;$("#sub").textContent=nis(sum);$("#total").textContent=nis(sum);
 const msg=cart.length?`שלום מאי, אשמח להזמין (הזמנה ${orderNo}):\n${lines.join("\n")}\nסה"כ: ${nis(sum)}\nאשמח לתאם איסוף עצמי באזור גילון או צורית.`:"שלום מאי, אשמח לשמוע על הציורים.";
 $("#wa").href=`https://wa.me/${PHONE}?text=${encodeURIComponent(msg)}`;$("#wa").setAttribute("aria-disabled",!cart.length);
 $("#waContact").href=`https://wa.me/${PHONE}?text=${encodeURIComponent("שלום מאי, אשמח לשמוע על הציורים.")}`;
}
function openCart(){$("#cart").classList.add("on");$("#shade").classList.add("on");$("#cart").setAttribute("aria-hidden","false")}
function closeCart(){$("#cart").classList.remove("on");$("#shade").classList.remove("on");$("#cart").setAttribute("aria-hidden","true")}
function zoom(p){$("#lbArt").replaceChildren(framed(p,p.id));$("#lbTxt").textContent=`${p.title} · ${meta(p)}`;$("#lb").classList.add("on")}
$("#print").onclick=()=>window.print();
$("#openCart").onclick=openCart;$("#closeCart").onclick=closeCart;$("#shade").onclick=closeCart;
$("#closeLb").onclick=()=>$("#lb").classList.remove("on");
$("#lb").onclick=e=>{if(e.target.id==="lb")$("#lb").classList.remove("on")};
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeCart();$("#lb").classList.remove("on")}});
$("#yr").textContent=new Date().getFullYear();
[PAINTINGS[0],PAINTINGS[2],PAINTINGS[1]].forEach((p,i)=>{const w=document.createElement("div");w.className="fr";w.append(framed(p,[0,1,2][i]===0?0:i===1?2:1));$("#wall").append(w)});
$("#aboutArt").append(art(PAINTINGS[4]));
render();

const SIZE_OPTIONS=[['15×15 ס״מ',25],['20×20 ס״מ',30],['30×30 ס״מ',40],['40×40 ס״מ',50],['50×50 ס״מ',60],['אחר',null]];
const MATERIAL_OPTIONS=[['🟦 אקריליק — ⭐⭐⭐ הכי מומלץ',0],['✏️ עפרונות — ⭐ מומלץ',5],['💧 צבעי מים',2],['🖍️ טושים',2]];
const COMPLEX_OPTIONS=[['⭐ לא מורכב',1],['⭐⭐ בינוני קטן',2],['⭐⭐⭐ בינוני',3],['⭐⭐⭐⭐ בינוני גדול',4],['⭐⭐⭐⭐⭐ מורכב מאוד',5]];
function choices(container,name,arr){document.getElementById(container).innerHTML=arr.map(([label,price],i)=>`<label class="choice"><input type="radio" name="${name}" value="${i}" ${i===0?'checked':''} required> ${label}<small>${price===null?'מחיר בתיאום':(price===0?'ללא תוספת':name==='size'?`₪${price}`:`+₪${price}`)}</small></label>`).join('')}
choices('sizes','size',SIZE_OPTIONS);choices('materials','material',MATERIAL_OPTIONS);choices('complexities','complexity',COMPLEX_OPTIONS);
const customForm=document.getElementById('customForm');
const getSelection=(name,opts)=>opts[Number(customForm.elements[name].value)];
function updateEstimate(){const size=getSelection('size',SIZE_OPTIONS),material=getSelection('material',MATERIAL_OPTIONS),complexity=getSelection('complexity',COMPLEX_OPTIONS);const other=size[1]===null;document.getElementById('otherWrap').hidden=!other;document.getElementById('otherSize').required=other;document.getElementById('estimatePrice').textContent=other?'ייקבע לאחר תיאום':`₪${size[1]+material[1]+complexity[1]}`;document.getElementById('estimateNote').textContent=other?'בחרתם גודל אחר. מאי תציע מחיר לאחר קבלת הפרטים.':'מחיר משוער לפי הגודל, הצבעים והמורכבות שבחרתם. המחיר יאושר מול מאי.';}
customForm.addEventListener('change',updateEstimate);updateEstimate();
document.getElementById('noDate').addEventListener('change',e=>{const inp=document.getElementById('dueDate');inp.disabled=e.target.checked;if(e.target.checked)inp.value='';});
document.getElementById('dueDate').min=new Date().toISOString().slice(0,10);
customForm.addEventListener('submit',e=>{e.preventDefault();if(!customForm.reportValidity())return;const f=new FormData(customForm),size=getSelection('size',SIZE_OPTIONS),material=getSelection('material',MATERIAL_OPTIONS),complexity=getSelection('complexity',COMPLEX_OPTIONS);const sum=size[1]===null?'מחיר ייקבע בתיאום':`₪${size[1]+material[1]+complexity[1]}`;const img=f.get('inspiration');const msg=['שלום מאי, אשמח לבקש ציור בהתאמה אישית 🎨',`שם: ${f.get('fullName')}`,`טלפון: ${f.get('phone')}`,f.get('email')?`אימייל: ${f.get('email')}`:'',`גודל: ${size[1]===null?f.get('otherSize'):size[0]}`,`סוג צבע: ${material[0]}`,`מורכבות (בחירת הלקוח): ${complexity[0]}`,`תיאור: ${f.get('description')}`,f.get('imageLink')?`קישור להשראה: ${f.get('imageLink')}`:'',img&&img.size?'יש לי תמונת השראה ואשלח אותה בשיחה.':'',`הערות: ${f.get('notes')||'אין'}`,`תאריך יעד: ${document.getElementById('noDate').checked?'אין תאריך מסוים':f.get('dueDate')||'לא צוין'}`,`מחיר משוער: ${sum}`,'הבקשה לא סופית עד לתיאום ואישור מול מאי.'].filter(Boolean).join('\n');document.getElementById('customWA').href=`https://wa.me/${PHONE}?text=${encodeURIComponent(msg)}`;document.getElementById('customDone').hidden=false;document.getElementById('customDone').scrollIntoView({behavior:'smooth',block:'center'});try{sessionStorage.setItem('mayCustomDraft',JSON.stringify(Object.fromEntries([...f.entries()].filter(([k,v])=>typeof v==='string'))))}catch(err){};});
</script>
